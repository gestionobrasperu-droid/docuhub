# Copia este archivo como .env y complétalo.
#   Copy-Item .env.example .env
# scripts/setup-windows.ps1 genera las claves aleatorias por ti.
# NUNCA subas el .env a Git: contiene las llaves de todo.

# ------------------------------------------------------------- aplicación --
APP_ENV=prod

# URL pública. Debe coincidir EXACTAMENTE con la URI de redirección que
# autorizaste en Google Cloud. Para pruebas locales: http://localhost:8080
APP_BASE_URL=https://docs.constructorapesam.com

# Clave de cifrado de los tokens de Google: 32 bytes en hexadecimal.
# Generar:  -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
# Si la cambias, hay que volver a conectar la cuenta de Google.
APP_ENCRYPTION_KEY=

# ------------------------------------------------------------ base de datos --
POSTGRES_USER=docuhub
POSTGRES_PASSWORD=
POSTGRES_DB=docuhub

# ------------------------------------------------------------ Google Drive --
# Se obtienen en Google Cloud Console (ver docs/02-GOOGLE-DRIVE-SETUP.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Permiso solicitado. `drive` da control total sobre el Drive de la cuenta;
# `drive.file` limita la app a lo que ella misma cree (más restrictivo).
DRIVE_SCOPE=https://www.googleapis.com/auth/drive

# ID de la Unidad Compartida, si usas Google Workspace. Vacío = "Mi unidad".
DRIVE_ID=

# Nombre de la carpeta que DocuHub crea dentro del Drive.
DRIVE_ROOT_FOLDER=DocuHub

# ------------------------------------------------------------------ límites --
# Aceptan sufijos: 500MB, 10GB, 2TB. Un 0 significa "sin límite".
DEFAULT_QUOTA_BYTES=10GB
DEFAULT_BANDWIDTH_BYTES=50GB

# Tamaño máximo de cada trozo de subida. 16MB va bien con Cloudflare,
# que en el plan gratuito corta las peticiones de más de 100MB.
MAX_CHUNK_BYTES=16MB

# Duración de la sesión antes de pedir contraseña otra vez.
SESSION_TTL=12h

# Ponlo en true cuando sirvas por HTTPS (con el túnel o con Caddy).
COOKIE_SECURE=true

# ------------------------------------------------- administrador inicial ---
# Solo se usa la primera vez, cuando la base está vacía.
# Si dejas la contraseña en blanco, el sistema genera una y la muestra en el
# log:  docker compose logs app
BOOTSTRAP_ADMIN_EMAIL=gestion.obrasperu@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=

# --------------------------------------------------------------- publicación --
# Token del túnel, del panel de Cloudflare Zero Trust (Networks → Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=

# Solo si usas el perfil `caddy` en lugar del túnel.
DOMAIN=docs.constructorapesam.com
