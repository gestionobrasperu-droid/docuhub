# Secretos: nunca deben salir de la laptop.
deploy/.env
*.env
!deploy/.env.example
*.pem
*.key
.cloudflared/
credentials.json
client_secret*.json

# Datos locales: volcados de la base, nunca el esquema.
backups/
logs/
*.sql
*.sql.zip
# Las migraciones sí se versionan: son parte del código, no datos.
!backend/internal/store/migrations/*.sql

# Dependencias y compilados
node_modules/
frontend/dist/
*.exe
docuhub
backend/docuhub

# El frontend compilado se genera en el build (Docker lo hace solo). Solo se
# versiona el marcador que necesita go:embed para que `go build` no falle en
# un clon recién hecho.
backend/web/dist/*
!backend/web/dist/.gitkeep

# Sistema y editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Token de API de Cloudflare para desplegar el Worker
deploy/cloudflare-worker/.token

# Cache local de wrangler (incluye el id de cuenta de Cloudflare)
deploy/cloudflare-worker/.wrangler/
